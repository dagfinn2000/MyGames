// MyGames data model.
//
// Design note: play data (status, rating, review, dates) lives directly on
// Game rather than in a separate "play entry" model. Every game row already
// belongs to exactly one user in this single-purpose app, so a join table
// would only add indirection.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/Linux glibc); the musl target is
  // what the Alpine-based Docker image needs at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayStatus {
  WANT_TO_PLAY
  PLAYING
  COMPLETED
  DROPPED // stopped playing, not finished
}

/// How you have the game: a disc or cartridge, a download you bought, or
/// through a subscription such as Game Pass or PlayStation Plus.
enum GameFormat {
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
}

/// Where your copy stands. A single `owned` boolean would have to mean both
/// "in my collection" and, when false, "on the wishlist", leaving nowhere
/// for a game borrowed from a friend or one you sold or traded in.
enum GameOwnership {
  OWNED
  WISHLIST
  /// Someone else's copy, currently with you.
  BORROWED
  /// Had it, but it's gone: sold, traded in, given away or lost.
  GIVEN_AWAY
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String // bcrypt
  /// Bumped whenever every existing session should stop working — currently
  /// a password change. Sessions are JWTs with no server-side row to delete,
  /// so the token carries the value it was minted with and `auth.ts` rejects
  /// it once the two disagree. Tokens without a value are treated as 0.
  tokenVersion Int         @default(0)
  /// Chosen UI theme (id from lib/themes.ts), so the look follows the
  /// account across browsers. Null = never picked one on this account;
  /// the client falls back to localStorage, then the default.
  theme        String?
  /// Preferred library view ({ sort, dir, group } — see lib/library-view.ts),
  /// applied when /games is opened without explicit view params so the
  /// chosen sort survives navigating away and back. Null = defaults.
  libraryView  Json?
  /// Everything set in the Preferences card on the Account page (see
  /// lib/preferences.ts): defaults for new games, date and number formats,
  /// time zone, sorting rules, catalogues, rating style and so on. One JSON
  /// column rather than a column per setting, so adding a setting needs no
  /// migration — parsePreferences fills in a default for anything missing.
  /// Null = never changed anything.
  preferences  Json?
  /// When this account last downloaded its backup zip (GET /api/export), so
  /// the Backup card can say how old the newest copy is. Null = never.
  lastBackupAt DateTime?
  createdAt    DateTime    @default(now())
  games        Game[]
  shelves      Shelf[]
  playGoals    PlayGoal[]
  savedViews   SavedView[]
}

/// A library view saved under a name ("Unplayed RPGs"): the filters, sort
/// and grouping exactly as they appear in the /games address. Shown as chips
/// above the library; Preferences can make one the view the library opens on.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// The /games query string, rebuilt from the parsed filters so only known
  /// parameters are ever stored (see lib/saved-views.ts).
  query     String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

enum GoalUnit {
  GAMES
  HOURS
}

/// A yearly goal ("12 games in 2026", or "300 hours"). Progress is derived
/// from the games completed and the time logged that year (see
/// lib/goals.ts); hitting the target earns a gold medal on the stats page.
model PlayGoal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  target       Int
  /// What `target` counts: completed games, or hours played.
  unit         GoalUnit @default(GAMES)
  /// Whether completing a game again counts. False = only games completed
  /// for the first time that year.
  countReplays Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year])
}

/// A user-defined shelf ("Couch co-op", "Soulslikes") — freeform grouping
/// independent of play status. Games can sit on many shelves at once;
/// deleting a shelf only removes the grouping, never the games.
model Shelf {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  games     Game[]

  @@unique([userId, name])
}

model Game {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- catalogue data ---
  title         String
  /// The studios that made it, e.g. ["FromSoftware"].
  developers    String[]      @default([])
  publisher     String?
  /// The platform you play it on ("Nintendo Switch", "PC"). Freeform, so
  /// any system can be typed; the form suggests the catalogue's list.
  platform      String?
  description   String?
  /// Either a local cached path ("/api/covers/<id>.jpg") or a remote URL.
  coverUrl      String?
  /// How long the game usually takes to beat, in minutes. Progress shows as
  /// a share of it, and the pace forecast counts down to it. Null = not
  /// known; time played is tracked all the same.
  lengthMinutes Int?
  /// Kept as a string because catalogues give partial dates ("1998", "2017-03").
  releaseDate   String?
  tags          String[]      @default([])
  format        GameFormat    @default(PHYSICAL)
  ownership     GameOwnership @default(OWNED)
  /// Freeform series name (e.g. "The Legend of Zelda"); groups games together.
  seriesName    String?
  /// Position in the series. Float so a spin-off can slot in at 2.5.
  seriesNumber  Float?
  shelves       Shelf[]
  /// The catalogue entry the game was imported from, prefixed by catalogue:
  /// "igdb:<slug>", "steam:<app id>" or "wikidata:<Q-id>" (for example
  /// "igdb:portal-2", "steam:620", "wikidata:Q279744"). Lets "Look up details"
  /// and the catalogue link find the same game again.
  catalogueId   String?

  // --- personal play data ---
  status         PlayStatus @default(WANT_TO_PLAY)
  /// 1–10 in half-star units: 7 = 3.5 stars. Null = unrated.
  rating         Int?
  review         String?
  dateStarted    DateTime?
  dateFinished   DateTime?
  timesCompleted Int        @default(0)
  /// Time played so far in this playthrough, in minutes. Kept while
  /// PLAYING, when COMPLETED (the time the playthrough took: "Completed in
  /// 42 h") and when DROPPED ("stopped at 12 h"); cleared only when the game
  /// goes back to WANT_TO_PLAY.
  playedMinutes  Int?

  /// Denormalized lowercase "title + developers + series + platform"
  /// (buildSearchText) so search can be a single case-insensitive `contains`
  /// (Prisma can't substring-search String[]).
  searchText       String @default("")
  /// The review, folded the same way (foldForSearch), for players who search
  /// reviews too; "" without one. Written wherever review is, never sent to
  /// the browser or into a backup.
  reviewSearchText String @default("")

  playthroughs Playthrough[]
  progress     ProgressEntry[]
  loans        Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  /// Year pages and per-year stats filter and sort on finish date.
  @@index([userId, dateFinished])
  /// Tag filter uses array containment, which a btree cannot serve.
  @@index([tags], type: Gin)
  /// Library search is a substring match (LIKE '%…%'); the series lookup is
  /// ILIKE. Both need trigrams (pg_trgm, created by the init migration).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Game_searchText_trgm_idx")
  @@index([seriesName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Game_seriesName_trgm_idx")
}

/// A *past* completed playthrough of a game. The Game row itself always
/// holds the latest one (status, dates, rating), so playing again archives
/// the previous pass here. `timesCompleted` on Game is kept in sync as
/// `playthroughs.count + (status == COMPLETED ? 1 : 0)` — see
/// lib/actions/playthroughs.ts.
model Playthrough {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Both dates optional: "I know I beat this in 2019" is a valid entry,
  /// and so is a fully undated "played it before" placeholder.
  dateStarted   DateTime?
  dateFinished  DateTime?
  /// What you rated it *that* time, 1–10 half-star units. Null = unrated;
  /// the Game row's rating stays your current overall rating.
  rating        Int?
  /// Time played on that playthrough, in minutes, when it was tracked.
  playedMinutes Int?
  /// What you thought that time, or how you played it ("100%, on hard").
  /// Optional, kept with the pass's dates and rating.
  note          String?

  createdAt DateTime @default(now())

  @@index([gameId, dateFinished])
}

/// A point-in-time play position: "on this date I had played N minutes".
/// Logged automatically whenever `playedMinutes` changes, so the play log
/// costs no extra effort. Powers the progress sparkline, pace/forecast, and
/// the play-days heatmap. Time played per day is always the *delta between
/// consecutive entries* of a game — a lone first entry contributes nothing,
/// which is what makes anchors work: each new playthrough starts with a
/// 0-minute anchor at the pass start (see logProgress in lib/actions/games.ts
/// and playAgain in lib/actions/playthroughs.ts; the latest 0-minute entry is
/// the pass boundary — see currentPassEntries in lib/progress.ts).
model ProgressEntry {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  minutes Int
  date    DateTime @default(now())

  @@index([gameId, date])
}

/// A copy of this game lent to someone. An open loan (`returnedAt` null) is
/// what makes a game "lent out"; returning one keeps the row as history, so
/// the game page can show who has borrowed it over the years.
///
/// Deliberately about *your* copy going out, not about games you borrowed —
/// that's `ownership = BORROWED` on the game itself.
model Loan {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// Freeform: a name, "my brother", whatever identifies where it went.
  borrower   String
  lentAt     DateTime  @default(now())
  /// Null while the game is still out.
  returnedAt DateTime?
  note       String?

  createdAt DateTime @default(now())

  /// Finding open loans, and listing a game's history newest-first.
  @@index([gameId, returnedAt])
  @@index([gameId, lentAt])
}

/// Caches raw catalogue responses (IGDB, Steam, Wikipedia) so repeated
/// lookups of the same query don't hit the external APIs. Rows are upserted
/// per (source, query) and considered stale after `expiresAt`.
model MetadataCache {
  id        String   @id @default(cuid())
  source    String // e.g. "igdb-search", "steam-app", "wiki-search"
  query     String // normalized (lowercased, trimmed) lookup key
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([source, query])
}
